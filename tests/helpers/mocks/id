#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/../mock_lib.sh"
mock_log "id" "$@"
if [ -n "${MOCK_ID_UID:-}" ]; then
  echo "$MOCK_ID_UID"
  exit 0
fi
# For id -u username, return 1000 for known users
if [[ "$*" == *"-u"* ]]; then
  user=$(echo "$*" | awk '{print $NF}')
  if [ "$user" = "testuser" ] || [ "$user" = "alice" ]; then
    echo "1000"
  else
    echo "1001"
  fi
  exit 0
fi
# For id -nG username, return the list of supplementary groups (controllable via MOCK_ID_NG)
if [[ "$*" == *"-nG"* ]]; then
  echo "${MOCK_ID_NG:-}"
  exit 0
fi
# For plain `id username`, succeed only for known test users; otherwise fail.
if [[ "$*" != *"-"* ]]; then
  user="${*%% *}"
  case "$user" in
    testuser|alice|root) exit 0 ;;
    *) echo "id: '$user': no such user" >&2; exit 1 ;;
  esac
fi
# delegate to real id
/usr/bin/id "$@" 2>/dev/null || echo "1000"
