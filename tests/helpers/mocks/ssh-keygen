#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/../mock_lib.sh"
mock_log "ssh-keygen" "$@"
# Emulate key creation for -f <path> so callers can use the .pub file
keyfile=""
prev=""
for arg in "$@"; do
  if [ "$prev" = "-f" ]; then
    keyfile="$arg"
  fi
  prev="$arg"
done
if [ -n "$keyfile" ]; then
  : > "$keyfile"
  : > "$keyfile.pub"
fi
exit 0
