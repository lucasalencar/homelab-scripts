#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/../mock_lib.sh"
mock_log "install" "$@"

mode=""
owner=""
group=""
src=""
dst=""

while [ $# -gt 0 ]; do
  case "$1" in
    -m) mode="$2"; shift 2 ;;
    -o) owner="$2"; shift 2 ;;
    -g) group="$2"; shift 2 ;;
    -*) shift ;;
    *)
      if [ -z "$src" ]; then src="$1"; else dst="$1"; fi
      shift
      ;;
  esac
done

[ -n "$src" ] && [ -n "$dst" ] || { echo "install mock: missing src or dst" >&2; exit 2; }

cp "$src" "$dst"
[ -n "$mode" ] && chmod "$mode" "$dst" 2>/dev/null || true
# chown may fail in test env (non-root) — log and ignore
[ -n "$owner" ] && chown "$owner" "$dst" 2>/dev/null || true
exit 0
