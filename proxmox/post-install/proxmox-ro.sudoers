# Read-only Proxmox introspection — template.
# Installed at /etc/sudoers.d/proxmox-ro (mode 0440, owner root:root).
# Permitido apenas o que não muda estado; tudo mais é recusado por padrão.

# Cluster / HA
__SUDO_USER__ ALL=(root) NOPASSWD: \
    /usr/bin/pvecm status, \
    /usr/bin/pvecm nodes, \
    /usr/bin/pvecm expected, \
    /usr/sbin/ha-manager status, \
    /usr/sbin/ha-manager config

# Version / API — somente leitura
__SUDO_USER__ ALL=(root) NOPASSWD: \
    /usr/bin/pveversion, \
    /usr/bin/pveversion -v, \
    /usr/bin/pvesh get *

# QEMU/KVM — somente leitura
__SUDO_USER__ ALL=(root) NOPASSWD: \
    /usr/sbin/qm list, \
    /usr/sbin/qm status, \
    /usr/sbin/qm config, \
    /usr/sbin/qm pending, \
    /usr/sbin/qm showcmd

# LXC — somente leitura
__SUDO_USER__ ALL=(root) NOPASSWD: \
    /usr/sbin/pct list, \
    /usr/sbin/pct status, \
    /usr/sbin/pct config, \
    /usr/sbin/pct pending, \
    /usr/sbin/pct listsnapshot

# QEMU snapshots — somente leitura
__SUDO_USER__ ALL=(root) NOPASSWD: \
    /usr/sbin/qm listsnapshot

# Templates
__SUDO_USER__ ALL=(root) NOPASSWD: \
    /usr/bin/pveam list, \
    /usr/bin/pveam available

# ZFS — somente leitura
__SUDO_USER__ ALL=(root) NOPASSWD: \
    /usr/bin/zfs list, \
    /usr/bin/zpool status, \
    /usr/bin/zpool list

# Firewall — somente leitura
__SUDO_USER__ ALL=(root) NOPASSWD: \
    /usr/sbin/pve-firewall status

# Storage
__SUDO_USER__ ALL=(root) NOPASSWD: \
    /usr/sbin/pvesm status, \
    /usr/sbin/pvesm list, \
    /usr/sbin/pvesm scan

# LVM — somente leitura (thinpool local-lvm)
__SUDO_USER__ ALL=(root) NOPASSWD: \
    /usr/sbin/lvs, \
    /usr/sbin/vgs, \
    /usr/sbin/pvs, \
    /usr/sbin/lvdisplay, \
    /usr/sbin/vgdisplay, \
    /usr/sbin/pvdisplay

# Node / Cert
__SUDO_USER__ ALL=(root) NOPASSWD: \
    /usr/bin/pvenode acmedetails, \
    /usr/bin/pvenode cert, \
    /usr/bin/pvenode status

# Cluster FS / Corosync
__SUDO_USER__ ALL=(root) NOPASSWD: \
    /usr/sbin/corosync-cfgtool -s
